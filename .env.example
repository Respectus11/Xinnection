# Copy to .env and fill in real values. Never commit the real .env.

DATABASE_URL="postgresql://user:password@localhost:5432/xinnection?schema=public"
REDIS_URL="redis://localhost:6379"

# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="<generate-a-random-32-byte-base64-secret>"

# One 32-byte base64 AES-256-GCM key per version
MSG_KEY_V1="<generate-a-random-32-byte-base64-key>"

TOKEN_PEPPER="<generate-a-random-pepper>"

# Optional shared secret for the retention cron: POST /api/admin/maintenance
# with header "x-maintenance-secret: <value>". Unset = only a SUPER_ADMIN
# session may trigger a purge.
MAINTENANCE_SECRET=""

# Rate limiting behaviour when Redis is unreachable: "true" (default) keeps
# the seeker flow available; "false" rejects instead (fail closed).
RATE_LIMIT_FAIL_OPEN="true"

SEED_ADMIN_EMAIL="admin@xinnection.local"
SEED_ADMIN_PASSWORD="<strong-password>"
SEED_PRO_EMAIL="professional@xinnection.local"
SEED_PRO_PASSWORD="<strong-password>"
